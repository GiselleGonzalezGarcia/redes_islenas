{:deps {:aliases [:dev]}
 :nrepl {:port 47920}
 :dev-http {8090 "resources/public"}
 :builds
 {:app {:target :browser
        :output-dir "resources/public/js"
        :asset-path "/js"
        :modules {:main {:init-fn redes.client.app/init!}}
        :devtools {:after-load redes.client.app/reload!}
        ;; release builds go elsewhere so they never clobber the dev server's bundle
        :release {:output-dir "target/release/js"}}}}
