;; Manual corrections to the transcription (canarios_todos.xlsx), applied by
;; redes.pipeline.build. Each entry documents what was wrong and how it was checked.
{:left-shift
 ;; PDF page 14 (printed page 13): in 'Datos originales' the LEFT half
 ;; (number … year) of rows 2–17 belongs to the printed row above; the RIGHT
 ;; half (ship … other data) is aligned. Printed row 17 is missing from the
 ;; sheet and sheet row 1 is empty. Verified against the column-wise re-OCR
 ;; (data/work/ocr/records.csv), which also gives the record numbers that the
 ;; sheet misread on these rows.
 [{:page 14 :rows [2 17]
   ;; printed row 1 has no sheet row at all: its right half, from the re-OCR
   :right {1 {:remarks "CUÑO DE PUNTAGORDA" :family "1" :archive "LA PALMA" :other "825"
              :pdf-page 14 :pdf-page2 15 :printed-page 13 :row 1}}
   :numbers {1 "13456" 2 "6881" 3 "2644" 4 "5176" 5 "12827" 6 "13377" 7 "6686" 8 "8572"
             9 "5929" 10 "11306" 11 "15953" 12 "15796" 13 "10579" 14 "2180" 15 "6914" 16 "9011"}}]

 :missing
 ;; Printed row 17 of PDF page 14, read from the re-OCR; adapted like the
 ;; 'Personas' sheet (birth year = record year − age).
 [{:page 14 :page2 15 :printed 13 :row 17
   :raw {:no "4756" :name "ACOSTA, ANTONIA" :natural "FUERTEVENTURA" :vecino "LA LAGUNA"
         :civil "Soltero(a)" :age 43 :signature "NO" :destination "CUBA" :year 1855}
   :persona {:no "4756" :surname-group "ACOSTA" :given "Antonia" :surname1 "Acosta" :sex "F"
             :civil "Soltero(a)" :birth-year 1812 :birth-island "Fuerteventura"
             :residence-year 1855
             :residence "San Cristóbal de La Laguna, Tenerife, Santa Cruz de Tenerife, España"
             :destination "Cuba"}}]

 :fixes
 ;; Single-record fixes: :raw overrides 'Datos originales', :persona overrides 'Personas'.
 [{:page 14 :row 1
   :why "Sheet read the surname as 'Z2STA'; the print and the re-OCR read ACOSTA."
   :raw {:name "ACOSTA RODRÍGUEZ, RAIM"}
   :persona {:surname1 "Acosta" :surname2 "Rodríguez" :surname-group "ACOSTA"}}]}
